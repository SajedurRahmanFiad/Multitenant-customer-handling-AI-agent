# ---- Application ----
APP_NAME="AI Support Platform"
APP_ENV=local                     # local | production
APP_URL=http://localhost:8000
PLATFORM_TOKEN=change-me-32+chars # server-to-server token (Authorization: Bearer)

# ---- Database ----
# mysql = production (cPanel/shared hosting OK); sqlite = local dev / smoke tests
DB_DRIVER=sqlite
# MySQL settings (used when DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_support
DB_USER=root
DB_PASSWORD=
DB_SQLITE_PATH=database/app.sqlite

# ---- CORS ----
CORS_ORIGINS=*

# ---- LLM providers (leave blank to use the built-in Mock provider) ----
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434

# ---- Webhooks ----
MESSENGER_VERIFY_TOKEN=changeme
WEBHOOK_SECRET_WOOCOMMERCE=
WEBHOOK_SECRET_STEADFAST=

# ---- Meta Login for Business (configure app + per-channel configurations in Meta Dashboard) ----
META_APP_ID=
META_APP_SECRET=
META_MESSENGER_CONFIG_ID=
META_WHATSAPP_CONFIG_ID=
META_GRAPH_VERSION=v27.0
FRONTEND_URL=http://localhost:5173
